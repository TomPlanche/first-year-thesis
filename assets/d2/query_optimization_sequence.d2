shape: sequence_diagram

resolver: "Résolveur GraphQL"
controller: "AttendanceStatsController"
sensors: "SensorsInternalHttpRepository"
repo: "AttendanceStatsRepository"
db: "MySQL"

resolver -> controller: "getAttendanceStatsForAPeriod()"

controller -> sensors: "getMeasuringSets()"
sensors -> controller: "measuringSetIds[]\n(~10-20 ms)"

controller -> repo: "getStats()"
repo -> db: "WHERE measuring_set_id IN (...)\nAND record_datetime_utc BETWEEN ..."
db -> repo: "résultats\n(index seek)"
repo -> controller: "AttendanceStats"

controller -> resolver: "réponse\n(~40 ms total)"
